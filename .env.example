# ==============================================================================
# 白猫打狗机器人 (WhiteCat Trading Bot)
# 生产与开发环境环境变量模板 (.env.example)
# ==============================================================================

# 1. Telegram Bot 网关配置
BOT_TOKEN=7654321098:AAEf...YOUR_TELEGRAM_BOT_TOKEN
RUN_BOT_NOW=false
DEFAULT_CHAIN=robinhood

# Protocol Fee (implementation in progress; read DEPLOYMENT.md before enabling)
# Default 0.6%; range 0 through 0.020. Set 0 to disable. Decimal notation only.
# No recipient addresses were supplied: enter your own PUBLIC cold-wallet addresses.
# Sui fee-enabled trades reject a missing/invalid recipient; EVM/Solana settlement is pending.
PROTOCOL_FEE_RATE=0.006
PROTOCOL_FEE_RECIPIENT_EVM=
PROTOCOL_FEE_RECIPIENT_SOLANA=
PROTOCOL_FEE_RECIPIENT_SUI=
PROTOCOL_FEE_RECIPIENT_TON=
PROTOCOL_FEE_RECIPIENT_APTOS=

# 2. Rust 交易内核 API 配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
BACKEND_CORE_URL=http://127.0.0.1:8080

# 3. 金融级密钥管理 (AES-256-GCM 32字节十六进制密钥)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. 多链 RPC 节点配置
# ★ Robinhood Chain (Arbitrum Orbit L2, Chain ID 4663)
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_WSS=wss://rpc.mainnet.chain.robinhood.com/ws
ROBINHOOD_CHAIN_ID=4663

# EVM 主流链
ETHEREUM_RPC=https://eth.llamarpc.com
BASE_RPC=https://mainnet.base.org
BSC_RPC=https://bsc-dataseed.binance.org

# Solana 与 Jito 防夹中继
SOLANA_RPC=https://api.mainnet-beta.solana.com
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# 5. 持久化存储 (PostgreSQL & Redis)
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/whitecat_db
REDIS_URL=redis://127.0.0.1:6379/0

# 6. 交易策略默认参数
DEFAULT_SLIPPAGE_PCT=5.0
DEFAULT_GAS_PRIORITY=turbo
ANTI_MEV_ENABLED=true
